# Copy to .env.local. Never commit .env.local.
ANTHROPIC_API_KEY=
# Claude plan runs: the one-year token from `claude setup-token`. Or save either value in Settings.
CLAUDE_CODE_OAUTH_TOKEN=
DATABASE_URL=postgresql://auditdesk:auditdesk@127.0.0.1:5433/auditdesk
TEST_DATABASE_URL=postgresql://auditdesk:auditdesk@127.0.0.1:5433/auditdesk_test
# Clones, run folders and exported reports. Keep it outside any repository.
WORKSPACE_DIR=~/.auditdesk/workspace
DEFAULT_BUDGET_USD=10
DEFAULT_BUDGET_TOKENS=400000
AUDITOR_NAME=Andrii Naidenko
