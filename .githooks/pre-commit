#!/bin/sh
# Scans the staged changes for secrets. Needs Docker running.
if ! docker info >/dev/null 2>&1; then
    echo "pre-commit: Docker is not running, so gitleaks cannot scan the staged files." >&2
    exit 1
fi
exec docker run --rm -v "$(pwd)":/repo -w /repo \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0='*' \
    ghcr.io/gitleaks/gitleaks:v8.30.1 git --pre-commit --staged --redact --no-banner /repo
