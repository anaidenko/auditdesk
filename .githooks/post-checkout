#!/bin/sh
# Regenerates the Prisma client when a branch checkout changes the schema: a stale client fails
# the build's type check ("Failed to type check") and every test of a new column.
[ "$3" = 1 ] || exit 0
git diff --quiet "$1" "$2" -- prisma/schema.prisma 2>/dev/null && exit 0
echo "post-checkout: prisma/schema.prisma changed; running prisma generate." >&2
DATABASE_URL="${DATABASE_URL:-$(sed -n 's/^DATABASE_URL=//p' .env.test)}" pnpm exec prisma generate >/dev/null 2>&1 || echo "post-checkout: prisma generate failed; run it by hand." >&2
exit 0
